<http://www.monumentoscyl.es/resource/monument/23778> a mon:Monument ;
    rdfs:label "Catedral de Ávila"@es ;
    mon:identifier 23778 ;
    mon:name "Catedral de Ávila"^^xsd:string ;
    mon:bicIdentifier "264"^^xsd:string ;
    mon:streetAddress "Pza. de la Catedral s/n"^^xsd:string ;
    mon:postalCode "05001"^^xsd:string ;
    mon:description "Es una catedral-castillo, en la que las almenas, matacanes y paseos de vigías combinan espléndidamente con su estructura. Su historia está indisolublemente unida a la de la ciudad, incluso su ábside, el llamado Cimorro, por el que asoma Alfonso VII, representando un hecho histórico, es motivo central del escudo de Ávila. Consagrada a San Salvador, la catedral comenzaría a construirse en el 1091."@es ;
    mon:latitude "40.655814"^^xsd:decimal ;
    mon:longitude "-4.697039"^^xsd:decimal ;
    mon:hasMonumentType <http://www.monumentoscyl.es/resource/monument-type/Catedrales> ;
    mon:hasClassification <http://www.monumentoscyl.es/resource/classification/ArquitecturaReligiosa> ;
    mon:hasConstructionType <http://www.monumentoscyl.es/resource/construction-type/Catedral> ;
    mon:hasHistoricalPeriod <http://www.monumentoscyl.es/resource/historical-period/EdadMedia> ;
    mon:locatedInLocality <http://www.monumentoscyl.es/resource/locality/Avila> ;
    mon:locatedInMunicipality <http://www.monumentoscyl.es/resource/municipality/Avila> ;
    mon:locatedInProvince <http://www.monumentoscyl.es/resource/province/Avila> .

<http://www.monumentoscyl.es/resource/monument/23779> a mon:Monument ;
    rdfs:label "Catedral de Burgos"@es ;
    mon:identifier 23779 ;
    mon:name "Catedral de Burgos"^^xsd:string ;
    mon:bicIdentifier "1715"^^xsd:string ;
    mon:streetAddress "Plaza de Santa María s/n"^^xsd:string ;
    mon:postalCode "09003"^^xsd:string ;
    mon:description "Es uno de los conjuntos arquitectónicos más hermosos del gótico español y está declarada Patrimonio Mundial por la UNESCO. Su construcción se prolongó desde 1221 hasta 1765 y, aunque predomina el estilo gótico, hay numerosas referencias artísticas repartidas por todo el edificio."@es ;
    mon:latitude "42.340820"^^xsd:decimal ;
    mon:longitude "-3.704384"^^xsd:decimal ;
    mon:hasMonumentType <http://www.monumentoscyl.es/resource/monument-type/Catedrales> ;
    mon:hasClassification <http://www.monumentoscyl.es/resource/classification/ArquitecturaReligiosa> ;
    mon:hasConstructionType <http://www.monumentoscyl.es/resource/construction-type/Catedral> ;
    mon:hasHistoricalPeriod <http://www.monumentoscyl.es/resource/historical-period/EdadMedia> ;
    mon:locatedInLocality <http://www.monumentoscyl.es/resource/locality/Burgos> ;
    mon:locatedInMunicipality <http://www.monumentoscyl.es/resource/municipality/Burgos> ;
    mon:locatedInProvince <http://www.monumentoscyl.es/resource/province/Burgos> .

<http://www.monumentoscyl.es/resource/monument/23780> a mon:Monument ;
    rdfs:label "Catedral de Astorga"@es ;
    mon:identifier 23780 ;
    mon:name "Catedral de Astorga"^^xsd:string ;
    mon:bicIdentifier "4282"^^xsd:string ;
    mon:streetAddress "Pza. de la Catedral, s/n"^^xsd:string ;
    mon:postalCode "24700"^^xsd:string ;
    mon:description "Es uno de los edificios más representativos de la capital maragata, ciudad noble, leal y bimilenaria de la provincia leonesa. Se empezó a construir, tal y como la conocemos en la actualidad, en 1471, en el mismo solar donde la precedieron otras catedrales románicas de los siglos XI al XIII."@es ;
    mon:latitude "42.457966"^^xsd:decimal ;
    mon:longitude "-6.056899"^^xsd:decimal ;
    mon:hasMonumentType <http://www.monumentoscyl.es/resource/monument-type/Catedrales> ;
    mon:hasClassification <http://www.monumentoscyl.es/resource/classification/ArquitecturaReligiosa> ;
    mon:hasConstructionType <http://www.monumentoscyl.es/resource/construction-type/Catedral> ;
    mon:hasHistoricalPeriod <http://www.monumentoscyl.es/resource/historical-period/EdadModerna> ;
    mon:locatedInLocality <http://www.monumentoscyl.es/resource/locality/Astorga> ;
    mon:locatedInMunicipality <http://www.monumentoscyl.es/resource/municipality/Astorga> ;
    mon:locatedInProvince <http://www.monumentoscyl.es/resource/province/Leon> .

<http://www.monumentoscyl.es/resource/monument/23784> a mon:Monument ;
    rdfs:label "Catedrales de Salamanca"@es ;
    mon:identifier 23784 ;
    mon:name "Catedrales de Salamanca"^^xsd:string ;
    mon:bicIdentifier "9598"^^xsd:string , "9618"^^xsd:string ;
    mon:streetAddress "Pl. Juan XXIII, s/n"^^xsd:string ;
    mon:postalCode "37008"^^xsd:string ;
    mon:description "Conjunto formado por la Catedral Vieja, iniciada en el siglo XII en estilo románico y de transición al gótico, y la Catedral Nueva, construida entre los siglos XVI y XVIII en estilos gótico tardío, renacentista y barroco."@es ;
    mon:latitude "40.960692"^^xsd:decimal ;
    mon:longitude "-5.666198"^^xsd:decimal ;
    mon:hasMonumentType <http://www.monumentoscyl.es/resource/monument-type/Catedrales> ;
    mon:hasClassification <http://www.monumentoscyl.es/resource/classification/ArquitecturaReligiosa> ;
    mon:hasConstructionType <http://www.monumentoscyl.es/resource/construction-type/Catedral> ;
    mon:hasHistoricalPeriod <http://www.monumentoscyl.es/resource/historical-period/EdadMedia> ,
                            <http://www.monumentoscyl.es/resource/historical-period/EdadModerna> ;
    mon:locatedInLocality <http://www.monumentoscyl.es/resource/locality/Salamanca> ;
    mon:locatedInMunicipality <http://www.monumentoscyl.es/resource/municipality/Salamanca> ;
    mon:locatedInProvince <http://www.monumentoscyl.es/resource/province/Salamanca> .

