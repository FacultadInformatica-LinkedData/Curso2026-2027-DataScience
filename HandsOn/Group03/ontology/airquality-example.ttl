    aq:hasLongitude -3.7122567 ;
    aq:hasStationType stationtype:UT ;
    aq:locatedInMunicipality municipality:28079 ;
    aq:measuresPollutant pollutant:NO2, pollutant:SO2, pollutant:CO .

stationtype:UT a aq:StationType ;
    rdfs:label "Urban traffic" ;
    aq:hasTypeCode "UT" .

municipality:28079 a aq:Municipality ;
    rdfs:label "Madrid" ;
    aq:hasMunicipalityCode "28079" .

pollutant:NO2 a aq:Pollutant ;
    rdfs:label "NO2" .

pollutant:SO2 a aq:Pollutant ;
    rdfs:label "SO2" .

pollutant:CO a aq:Pollutant ;
