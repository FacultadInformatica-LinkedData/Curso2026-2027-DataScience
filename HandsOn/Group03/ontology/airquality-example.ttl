@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Sample data taken from the stations CSV (station 28079004) and from the
# hourly CSV (station 4, magnitude 6, 30 September 2026, hours 1 to 3).

station:28079004 a aq:Station ;
    rdfs:label "Plaza de España" ;
    aq:hasStationCode "28079004" ;
    aq:hasAddress "Plaza de España" ;
    aq:hasAltitude 637 ;
