    aq:ofPollutant pollutant:CO ;
    aq:hasDate "2026-09-30"^^xsd:date ;
    aq:hasHour 1 ;
    aq:hasValue 0.2 ;
    aq:hasValidityFlag "V" .

measurement:28079004-6-2026-09-30-H02 a aq:Measurement ;
