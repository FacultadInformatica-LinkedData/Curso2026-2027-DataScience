
@prefix bme: <http://www.bicimadexplorer.es/ontology/bicimad#> .
@prefix station: <http://www.bicimadexplorer.es/resource/station/> .
@prefix address: <http://www.bicimadexplorer.es/resource/address/> .
@prefix location: <http://www.bicimadexplorer.es/resource/location/> .
@prefix status: <http://www.bicimadexplorer.es/resource/status/> .
@prefix occupancy: <http://www.bicimadexplorer.es/resource/occupancy/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# Estacion 1 - Metro Callao

station:2 a bme:Station ;
    bme:objectId 1 ;
    bme:stationNumber "2" ;
    bme:stationName "2 - Metro Callao" ;
    bme:totalDocks 27 ;
    bme:isActive true ;
    bme:isUnavailable false ;
    bme:hasAddress address:2 ;
    bme:hasLocation location:2 ;
    bme:hasStatus status:IN_SERVICE .

address:2 a bme:Address ;
    bme:streetAddress "Calle Miguel Moya nº 1," .

location:2 a bme:Location ;
    bme:longitude "-3.70569"^^xsd:decimal ;
    bme:latitude "40.4204"^^xsd:decimal .


