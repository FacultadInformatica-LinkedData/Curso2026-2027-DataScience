@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ns: <http://madrid-recarga.linkeddata.es/group06/ontology#> .

# ==========================================================
# 1. DISTRITO
# ==========================================================
<#TriplesMapDistrito>
    rml:logicalSource [
        rml:source "data/vehiculos-electricos-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://madrid-recarga.linkeddata.es/group06/resource/Distrito/{DISTRITO}" ;
        rr:termType rr:IRI ;
        rr:class ns:Distrito
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "DISTRITO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:codDistrito ;
        rr:objectMap [ rml:reference "COD_DIS" ; rr:termType rr:Literal ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:nombreDistrito ;
        rr:objectMap [ rml:reference "DISTRITO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] .

# ==========================================================
# 2. BARRIO
# ==========================================================
<#TriplesMapBarrio>
    rml:logicalSource [
        rml:source "data/vehiculos-electricos-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://madrid-recarga.linkeddata.es/group06/resource/Barrio/{BARRIO}" ;
        rr:termType rr:IRI ;
        rr:class ns:Barrio
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "BARRIO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:codBarrio ;
        rr:objectMap [ rml:reference "COD_BAR" ; rr:termType rr:Literal ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:nombreBarrio ;
        rr:objectMap [ rml:reference "BARRIO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:ubicadoEnDistrito ;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapDistrito> ;
            rr:joinCondition [
                rr:child "DISTRITO" ;
                rr:parent "DISTRITO"
            ]
        ]
    ] .

# ==========================================================
# 3. OPERADOR
# ==========================================================
<#TriplesMapOperador>
    rml:logicalSource [
        rml:source "data/vehiculos-electricos-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://madrid-recarga.linkeddata.es/group06/resource/Operador/{OPERADOR}" ;
        rr:termType rr:IRI ;
        rr:class ns:Operador
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "OPERADOR" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:nombreOperador ;
        rr:objectMap [ rml:reference "OPERADOR" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] .

# ==========================================================
# 4. UBICACION
# ==========================================================
<#TriplesMapUbicacion>
    rml:logicalSource [
        rml:source "data/vehiculos-electricos-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://madrid-recarga.linkeddata.es/group06/resource/Ubicacion/{UBICACIÓN}" ;
        rr:termType rr:IRI ;
        rr:class ns:Ubicacion
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "UBICACIÓN" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:nombreUbicacion ;
        rr:objectMap [ rml:reference "UBICACIÓN" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:emplazamiento ;
        rr:objectMap [ rml:reference "EMPLAZAMIE" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:infoAdicional ;
        rr:objectMap [ rml:reference "INFO_ADICI" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:puntoX ;
        rr:objectMap [ rml:reference "POINT_X" ; rr:termType rr:Literal ; rr:datatype xsd:float ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:puntoY ;
        rr:objectMap [ rml:reference "POINT_Y" ; rr:termType rr:Literal ; rr:datatype xsd:float ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:ubicadoEnBarrio ;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapBarrio> ;
            rr:joinCondition [
                rr:child "BARRIO" ;
                rr:parent "BARRIO"
            ]
        ]
    ] .

# ==========================================================
# 5. PUNTO DE RECARGA
# ==========================================================
<#TriplesMapPuntoRecarga>
    rml:logicalSource [
        rml:source "data/vehiculos-electricos-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://madrid-recarga.linkeddata.es/group06/resource/PuntoRecarga/{UBICACIÓN}" ;
        rr:termType rr:IRI ;
        rr:class ns:PuntoRecarga
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "UBICACIÓN" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:numeroEquipo ;
        rr:objectMap [ rml:reference "Nº_EQUIPO" ; rr:termType rr:Literal ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:caracteristicas ;
        rr:objectMap [ rml:reference "CARACTERÍ" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:tieneUbicacion ;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapUbicacion> ;
            rr:joinCondition [
                rr:child "UBICACIÓN" ;
                rr:parent "UBICACIÓN"
            ]
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ns:gestionadoPor ;
        rr:objectMap [
            rr:parentTriplesMap <#TriplesMapOperador> ;
            rr:joinCondition [
                rr:child "OPERADOR" ;
                rr:parent "OPERADOR"
            ]
        ]
    ] .