@prefix mod: <https://w3id.org/mod#> .
@prefix ns: <http://madrid-recarga.linkeddata.es/group06/ontology#> .
@prefix res: <http://madrid-recarga.linkeddata.es/group06/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# 1. Estación de recarga 1 (Fila 1 del CSV)
res:PuntoRecarga/1 a ns:PuntoRecarga ;
    ns:numeroEquipo 1 ;
    ns:caracteristicas "50 kW 2 conectores CC (CCS/Chademo) y 1 conector AC modo 2 Mennekes" ;
    ns:tieneUbicacion res:Ubicacion/calle-chulapos-sn ;
    ns:gestionadoPor res:Operador/iberdrola .

# 2. Ubicación física
res:Ubicacion/calle-chulapos-sn a ns:Ubicacion ;
    ns:nombreUbicacion "Calle Chulapos s/n" ;
    ns:emplazamiento "Vía pública" ;
    ns:infoAdicional "-" ;
    ns:puntoX "438893.73"^^xsd:float ;
    ns:puntoY "4473226.26"^^xsd:float ;
    ns:ubicadoEnBarrio res:Barrio/2-1 .

# 3. Barrio
res:Barrio/2-1 a ns:Barrio ;
    ns:codBarrio 1 ;
    ns:nombreBarrio "Imperial" ;
    ns:ubicadoEnDistrito res:Distrito/2 .

# 4. Distrito
res:Distrito/2 a ns:Distrito ;
    ns:codDistrito 2 ;
    ns:nombreDistrito "Arganzuela" .

# 5. Operador
res:Operador/iberdrola a ns:Operador ;
    ns:nombreOperador "IBERDROLA" .