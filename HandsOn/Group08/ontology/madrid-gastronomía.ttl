###  https://gastronomad.es/group08/ontology#locatedInBarrio
ex:locatedInBarrio rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain ex:Mercado ;
                   rdfs:range ex:Barrio .


###  https://gastronomad.es/group08/ontology#perteneceADistrito
ex:perteneceADistrito rdf:type owl:ObjectProperty ;
                      rdfs:domain ex:Barrio ;
                      rdfs:range ex:Distrito .


